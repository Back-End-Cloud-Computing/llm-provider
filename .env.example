# --- Application ---
APP_NAME=llm-provider
APP_ENV=development
LOG_LEVEL=INFO

AUTH_SERVICE_BASE_URL=http://authorization:8081

# --- LLM provider ---
LLM_PROVIDER=mock
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-ultra-550b-a55b:free,dots-studio/dots-3-note-preview:free,openrouter/free
OPENROUTER_DISABLE_REASONING=true
LLM_TIMEOUT_SECONDS=60
